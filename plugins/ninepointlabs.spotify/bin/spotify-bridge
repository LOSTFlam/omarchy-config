#!/usr/bin/python3 -I
"""spotify-bridge — the Spotify Web API helper behind the Omarchy Spotify plugin.

The QML side never talks HTTP itself. It runs this script with one subcommand
per request and reads exactly one JSON object from stdout:

    {"ok": true,  "data": ...}
    {"ok": false, "code": "<machine code>", "error": "<human text>"}

Handled failures (no device, rate limit, signed out, ...) still exit 0 so the
shell can branch on `code`; only an unexpected crash exits non-zero.

Auth is the PKCE flow (no client secret). Tokens live in
$XDG_STATE_HOME/omarchy-spotify/auth.json (0600). Cover art is cached under
$XDG_CACHE_HOME/omarchy-spotify/art so panel lists load from disk.

Trust boundaries: the bridge runs under an isolated interpreter
(`/usr/bin/python3 -I`) with a scrubbed environment; every program it starts
is an absolute path from root-owned system directories with a rebuilt
environment; every file it reads or writes is opened relative to a held,
checked directory descriptor without following symlinks; and every HTTP body
is read against a byte cap and an overall deadline.

Only Python's standard library is used.
"""

import argparse
import base64
import errno
import hashlib
import html
import http.client as http_client
import json
import pwd
import re
import os
import secrets
import ssl
import stat
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor
from http.server import BaseHTTPRequestHandler, HTTPServer

API = "https://api.spotify.com/v1"
ACCOUNTS = "https://accounts.spotify.com"
USER_AGENT = "omarchy-spotify/0.1 (+https://github.com/ninepointlabs/omarchy-spotify)"

SCOPES = [
    "user-read-playback-state",
    "user-modify-playback-state",
    "user-read-currently-playing",
    "user-read-recently-played",
    "user-library-read",
    "user-library-modify",
    "playlist-read-private",
    "playlist-read-collaborative",
]

HTTP_TIMEOUT = 15
ART_TIMEOUT = 8
ART_WORKERS = 8
ART_MAX_BYTES = 8 * 1024 * 1024
# Every Web API and token reply is JSON far below this. A larger body is
# refused before it is decoded or parsed.
API_MAX_BYTES = 2 * 1024 * 1024
ERROR_MAX_BYTES = 64 * 1024
# Cover art is only ever fetched from Spotify's own image CDNs.
ART_HOST_RE = re.compile(r"^(?:[a-z0-9-]+\.)*(?:scdn\.co|spotifycdn\.com)$")
ART_NAME_RE = re.compile(r"^[0-9a-f]{28}\.jpg$")

AUTH_MAX_BYTES = 64 * 1024
LAST_MAX_BYTES = 16 * 1024
UNIT_MAX_BYTES = 64 * 1024
# The process table, and the most of any one command line the argv audit reads.
# Linux caps a command line well below this; the limit only stops the audit
# from being led anywhere unbounded.
PROC_DIR = "/proc"
CMDLINE_MAX_BYTES = 128 * 1024

SPOTIFY_ID_RE = re.compile(r"^[A-Za-z0-9]{1,64}$")
SPOTIFY_URI_RE = re.compile(r"^spotify:[a-z_]+:[A-Za-z0-9:_-]{1,128}$")


def safe_id(value):
    """Spotify IDs are base62. Anything else must not reach a URL path."""
    s = str(value or "").strip()
    if not SPOTIFY_ID_RE.match(s):
        raise ApiError("bad_args", "Not a Spotify ID: %r" % s[:40])
    return s


def safe_uris(values):
    uris = [str(v or "").strip() for v in values]
    for u in uris:
        if not SPOTIFY_URI_RE.match(u):
            raise ApiError("bad_args", "Not a Spotify URI: %r" % u[:60])
    return uris


# --------------------------------------------------------------------- output

def out(data):
    sys.stdout.write(json.dumps({"ok": True, "data": data}, ensure_ascii=False))
    sys.stdout.write("\n")
    sys.stdout.flush()


def fail(code, message, extra=None):
    payload = {"ok": False, "code": code, "error": message}
    if extra:
        payload.update(extra)
    sys.stdout.write(json.dumps(payload, ensure_ascii=False))
    sys.stdout.write("\n")
    sys.stdout.flush()


class ApiError(Exception):
    def __init__(self, code, message, status=0, retry_after=0):
        super().__init__(message)
        self.code = code
        self.message = message
        self.status = status
        self.retry_after = retry_after


# --------------------------------------------------------------- environment
#
# Nothing the bridge starts is looked up through the session PATH, and nothing
# it starts sees the session's environment. Programs come from a fixed list of
# root-owned system directories, and each child gets a rebuilt environment
# holding only what that child needs.

# /usr/local/bin and anything under $HOME are deliberately absent: those are
# the usual landing spots for a shadow binary.
TRUSTED_BIN_DIRS = ("/usr/bin", "/bin", "/usr/sbin", "/sbin", "/run/current-system/sw/bin")
# Omarchy's own launchers ship in its tree; the system directories still win.
TRUSTED_OMARCHY_DIRS = TRUSTED_BIN_DIRS + ("/usr/share/omarchy/bin", "/usr/local/share/omarchy/bin")
TRUSTED_PATH = ":".join(TRUSTED_BIN_DIRS)
# A browser launch goes through Omarchy scripts that name their own helpers.
TRUSTED_SESSION_PATH = ":".join(TRUSTED_BIN_DIRS + ("/usr/share/omarchy/bin",))

# Directory variables, honoured only as clean absolute paths.
PATH_ENV_NAMES = ("HOME", "XDG_STATE_HOME", "XDG_CACHE_HOME", "XDG_CONFIG_HOME",
                  "XDG_DATA_HOME", "XDG_RUNTIME_DIR")
# What `systemctl --user` needs to reach the user manager.
BUS_ENV_NAMES = ("USER", "LOGNAME", "DBUS_SESSION_BUS_ADDRESS")
# What opening the login page in a browser needs to reach the graphical session.
DISPLAY_ENV_NAMES = ("LANG", "WAYLAND_DISPLAY", "DISPLAY", "XDG_CURRENT_DESKTOP",
                     "XDG_SESSION_TYPE", "XDG_SESSION_DESKTOP", "HYPRLAND_INSTANCE_SIGNATURE")
ALLOWED_ENV_NAMES = PATH_ENV_NAMES + BUS_ENV_NAMES + DISPLAY_ENV_NAMES
TOOL_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")


def clean_env_value(name, value):
    """`value` when it is a bounded single-line string (and, for a directory
    variable, a normalized absolute path); "" for anything else."""
    if not isinstance(value, str) or not value or len(value) > 4096 or CONTROL_RE.search(value):
        return ""
    if name in PATH_ENV_NAMES:
        if not value.startswith("/") or value.startswith("//") or os.path.normpath(value) != value:
            return ""
    return value


def scrub_environment():
    """Replace the inherited environment with the allow-listed variables and a
    fixed PATH before anything consults it — urllib's proxy lookup, ssl's
    SSL_CERT_FILE, subprocess resolution. The interpreter itself already runs
    with -I, so PYTHON* variables and user site-packages never applied."""
    kept = {}
    for name in ALLOWED_ENV_NAMES:
        value = clean_env_value(name, os.environ.get(name))
        if value:
            kept[name] = value
    os.environ.clear()
    os.environ.update(kept)
    os.environ["PATH"] = TRUSTED_PATH


def child_env(display=False):
    """The complete environment for a child process: the fixed PATH, the
    directory and session-bus variables, and — only for a browser launch —
    what reaches the display. Nothing else (LD_PRELOAD, BASH_ENV, exported
    shell functions, proxies) is carried over."""
    env = {"PATH": TRUSTED_SESSION_PATH if display else TRUSTED_PATH}
    for name in PATH_ENV_NAMES + BUS_ENV_NAMES + (DISPLAY_ENV_NAMES if display else ()):
        value = clean_env_value(name, os.environ.get(name))
        if value:
            env[name] = value
    if not display:
        env["LC_ALL"] = "C"
    return env


def home():
    return clean_env_value("HOME", os.environ.get("HOME")) or pwd.getpwuid(os.geteuid()).pw_dir


def xdg_home(name, *fallback):
    return clean_env_value(name, os.environ.get(name)) or os.path.join(home(), *fallback)


def safe_chain(path, owners):
    """True when every component of the absolute, symlink-free `path`, from /
    down to and including its last one, exists, is owned by one of `owners`,
    and is writable by nobody else. A root-owned sticky directory (/tmp,
    /nix/store) is allowed along the way: nobody but an entry's owner can
    rename or remove what is in it."""
    parts = path.split("/")
    for i in range(1, len(parts) + 1):
        prefix = "/".join(parts[:i]) or "/"
        try:
            st = os.lstat(prefix)
        except OSError:
            return False
        if stat.S_ISLNK(st.st_mode) or st.st_uid not in owners:
            return False
        if st.st_mode & 0o022 and not (st.st_uid == 0 and stat.S_ISDIR(st.st_mode) and st.st_mode & stat.S_ISVTX):
            return False
    return True


def trusted_tool(name, dirs=TRUSTED_BIN_DIRS):
    """Absolute path of `name` in the first trusted directory holding it, or ""
    — never a PATH lookup. The file it resolves to, and every directory on the
    way to it, must be root-owned and writable by nobody else."""
    if not TOOL_NAME_RE.match(name or ""):
        return ""
    for directory in dirs:
        candidate = directory + "/" + name
        try:
            st = os.stat(candidate)
        except OSError:
            continue
        if not stat.S_ISREG(st.st_mode) or not st.st_mode & 0o111:
            continue
        if safe_chain(os.path.realpath(directory), (0,)) and safe_chain(os.path.realpath(candidate), (0,)):
            return candidate
    return ""


def user_executable(path):
    """True for a regular executable owned by root or by this user, reached
    only through directories nobody else can write to — both where `path`
    sits and wherever a symlink there leads."""
    owners = (0, os.geteuid())
    try:
        st = os.stat(path)
    except OSError:
        return False
    if not stat.S_ISREG(st.st_mode) or not st.st_mode & 0o111:
        return False
    return (safe_chain(os.path.realpath(os.path.dirname(path)), owners)
            and safe_chain(os.path.realpath(path), owners))


# ------------------------------------------------------------ private files
#
# Every file the bridge touches lives below a directory it holds open by
# descriptor, and every operation on it is relative to that descriptor, so a
# pathname swapped afterwards cannot redirect a read or a write.

DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
READ_FLAGS = os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK | os.O_NOCTTY
CREATE_FLAGS = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC
MAX_SYMLINK_HOPS = 16
ENTRY_NAME_RE = re.compile(r"^(?!\.\.?$)[A-Za-z0-9._-]{1,128}$")


class UnsafePath(ApiError):
    def __init__(self, message):
        super().__init__("unsafe_path", message)


class HeldDir:
    """A directory held open by descriptor; `path` is only for messages and for
    telling the panel where cover art landed."""

    def __init__(self, fd, path):
        self.fd = fd
        self.path = path

    def __enter__(self):
        return self

    def __exit__(self, *exc):
        self.close()

    def close(self):
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1

    def entry(self, name):
        return self.path.rstrip("/") + "/" + name


def _check_dir(st, where):
    if not stat.S_ISDIR(st.st_mode):
        raise UnsafePath("%s is not a directory" % where)
    if st.st_uid not in (0, os.geteuid()):
        raise UnsafePath("%s is owned by another user" % where)
    if st.st_mode & 0o022 and not (st.st_uid == 0 and st.st_mode & stat.S_ISVTX):
        raise UnsafePath("%s is writable by other users" % where)


def _open_child(parent_fd, name, where, create):
    """Open one directory component below `parent_fd` without following a
    symlink. Returns (fd, None), or (None, target) when the entry is a symlink,
    so the caller decides whether one is acceptable there."""
    try:
        st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    except FileNotFoundError:
        if not create:
            raise
        try:
            os.mkdir(name, 0o700, dir_fd=parent_fd)
        except FileExistsError:
            pass
        st = os.stat(name, dir_fd=parent_fd, follow_symlinks=False)
    if stat.S_ISLNK(st.st_mode):
        if st.st_uid not in (0, os.geteuid()):
            raise UnsafePath("%s is a symbolic link owned by another user" % where)
        return None, os.readlink(name, dir_fd=parent_fd)
    try:
        fd = os.open(name, DIR_FLAGS, dir_fd=parent_fd)
    except OSError as err:
        if err.errno in (errno.ELOOP, errno.ENOTDIR):
            raise UnsafePath("%s changed while it was being opened" % where)
        raise
    try:
        held = os.fstat(fd)
        if (held.st_dev, held.st_ino) != (st.st_dev, st.st_ino):
            raise UnsafePath("%s changed while it was being opened" % where)
        _check_dir(held, where)
    except BaseException:
        os.close(fd)
        raise
    return fd, None


def open_dir(base, owned=(), create=False):
    """Hold `base`/`owned...` open and return it as a HeldDir.

    `base` (an XDG directory, or one below it) is walked from / one component
    at a time. Each directory must be owned by root or by you and writable by
    nobody else. A symlink along `base` is followed only if it is yours or
    root's, and then everything it leads through passes the same checks — so a
    dotfile manager's symlinked ~/.config keeps working while a link into
    someone else's directory does not.

    The `owned` components below it belong to this plugin: each must be a real
    directory (never a symlink) owned by you, and is tightened to 0700 when
    `create` is set. Missing components are created 0700 only with `create`;
    otherwise FileNotFoundError propagates."""
    if not isinstance(base, str) or not base.startswith("/") or "\x00" in base:
        raise UnsafePath("Not an absolute directory: %r" % (base,))
    stack = [os.open("/", DIR_FLAGS)]
    names = []
    try:
        _check_dir(os.fstat(stack[0]), "/")
        pending = [part for part in reversed(base.split("/")) if part]
        hops = 0
        while pending:
            name = pending.pop()
            if name == ".":
                continue
            if name == "..":
                if len(stack) > 1:
                    os.close(stack.pop())
                    names.pop()
                continue
            where = "/" + "/".join(names + [name])
            fd, target = _open_child(stack[-1], name, where, create)
            if target is not None:
                hops += 1
                if hops > MAX_SYMLINK_HOPS:
                    raise UnsafePath("Too many symbolic links under %s" % base)
                if target.startswith("/"):
                    while len(stack) > 1:
                        os.close(stack.pop())
                    names = []
                pending.extend(part for part in reversed(target.split("/")) if part)
                continue
            stack.append(fd)
            names.append(name)
        for name in owned:
            if not ENTRY_NAME_RE.match(name):
                raise UnsafePath("Bad directory name: %r" % (name,))
            where = "/" + "/".join(names + [name])
            fd, target = _open_child(stack[-1], name, where, create)
            if target is not None:
                raise UnsafePath("%s is a symbolic link" % where)
            stack.append(fd)
            names.append(name)
            st = os.fstat(fd)
            if st.st_uid != os.geteuid():
                raise UnsafePath("%s is not owned by you" % where)
            if create and st.st_mode & 0o077:
                os.fchmod(fd, 0o700)
        return HeldDir(stack.pop(), "/" + "/".join(names))
    finally:
        for fd in stack:
            os.close(fd)


def read_file_at(held, name, limit, private):
    """The bytes of regular file `name` below `held`, or None when there is no
    such entry. Refused with UnsafePath: a symlink (O_NOFOLLOW), a FIFO, socket
    or device (opened non-blocking so it cannot hang, then rejected by type), a
    file owned by someone else or with a second hard link, one others can write
    — or, when `private`, read — and anything larger than `limit` bytes, which
    is never read past limit + 1."""
    where = held.entry(name)
    if not ENTRY_NAME_RE.match(name):
        raise UnsafePath("Bad file name: %r" % (name,))
    try:
        fd = os.open(name, READ_FLAGS, dir_fd=held.fd)
    except FileNotFoundError:
        return None
    except OSError as err:
        if err.errno == errno.ELOOP:
            raise UnsafePath("%s is a symbolic link" % where)
        raise
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise UnsafePath("%s is not a regular file" % where)
        if st.st_uid != os.geteuid():
            raise UnsafePath("%s is not owned by you" % where)
        if st.st_nlink != 1:
            raise UnsafePath("%s has more than one hard link" % where)
        if st.st_mode & (0o077 if private else 0o022):
            raise UnsafePath("%s is open to other users (mode %o) — chmod 600 it"
                             % (where, stat.S_IMODE(st.st_mode)))
        if st.st_size > limit:
            raise UnsafePath("%s is larger than %d bytes" % (where, limit))
        chunks = []
        total = 0
        while total <= limit:
            chunk = os.read(fd, min(65536, limit + 1 - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        if total > limit:
            raise UnsafePath("%s is larger than %d bytes" % (where, limit))
        return b"".join(chunks)
    finally:
        os.close(fd)


def write_file_at(held, name, data, mode=0o600):
    """Atomically replace `name` below `held` with `data`.

    The content goes into a fresh, unpredictably named temp file created with
    O_CREAT|O_EXCL|O_NOFOLLOW at 0600 — so nothing planted in advance can be
    written through — then fsynced and renamed over `name` within the same held
    directory. rename(2) replaces a directory entry and never follows one. An
    existing `name` that is not a regular file you own (a symlink, a FIFO,
    someone else's file) is refused rather than replaced. The temp file is
    removed on any failure."""
    where = held.entry(name)
    if not ENTRY_NAME_RE.match(name):
        raise UnsafePath("Bad file name: %r" % (name,))
    try:
        st = os.stat(name, dir_fd=held.fd, follow_symlinks=False)
    except FileNotFoundError:
        st = None
    if st is not None and (not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid()):
        raise UnsafePath("Refusing to replace %s: it is not a regular file you own" % where)
    tmp = ".%s.%s.tmp" % (name, secrets.token_hex(12))
    fd = os.open(tmp, CREATE_FLAGS, 0o600, dir_fd=held.fd)
    try:
        try:
            os.fchmod(fd, mode)
            view = memoryview(data)
            while view:
                view = view[os.write(fd, view):]
            os.fsync(fd)
        finally:
            os.close(fd)
        os.rename(tmp, name, src_dir_fd=held.fd, dst_dir_fd=held.fd)
    except BaseException:
        try:
            os.unlink(tmp, dir_fd=held.fd)
        except OSError:
            pass
        raise
    try:
        os.fsync(held.fd)
    except OSError:
        pass


def unlink_at(held, name):
    """Remove the entry itself (a symlink is removed, never followed)."""
    try:
        os.unlink(name, dir_fd=held.fd)
        return True
    except OSError:
        return False


def lexists_at(held, name):
    try:
        os.stat(name, dir_fd=held.fd, follow_symlinks=False)
        return True
    except OSError:
        return False


# ---------------------------------------------------------------- auth store

def state_dir(create=False):
    return open_dir(xdg_home("XDG_STATE_HOME", ".local", "state"), ("omarchy-spotify",), create)


def load_json_at(held, name, limit, private):
    blob = read_file_at(held, name, limit, private)
    if not blob:
        return {}
    try:
        data = json.loads(blob.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def load_auth():
    """The stored login, or {} when there is none. An auth.json that is a
    symlink, not yours, open to other users, hard-linked or oversized raises
    UnsafePath: it is neither read nor silently treated as signed out."""
    try:
        with state_dir() as held:
            return load_json_at(held, "auth.json", AUTH_MAX_BYTES, private=True)
    except FileNotFoundError:
        return {}


def save_auth(auth):
    blob = json.dumps(auth).encode("utf-8")
    with state_dir(create=True) as held:
        write_file_at(held, "auth.json", blob, 0o600)
        # The fixed temp name earlier versions wrote through; never used again.
        unlink_at(held, "auth.json.tmp")


def clear_auth():
    try:
        with state_dir() as held:
            unlink_at(held, "auth.json")
            unlink_at(held, "auth.json.tmp")
    except FileNotFoundError:
        pass


def load_last():
    """The remembered last item, only if its artPath is a cover this bridge
    cached: the panel loads that path as an image."""
    try:
        with state_dir() as held:
            data = load_json_at(held, "last-played.json", LAST_MAX_BYTES, private=False)
        with open_dir(xdg_home("XDG_CACHE_HOME", ".cache"), ("omarchy-spotify", "art")) as art:
            art_root = art.path
    except (OSError, ApiError):
        return {}
    art_path = data.get("artPath")
    if (not isinstance(art_path, str) or os.path.dirname(art_path) != art_root
            or not ART_NAME_RE.match(os.path.basename(art_path))):
        return {}
    return {key: str(data.get(key) or "")[:2048] for key in ("uri", "name", "subtitle", "art", "artPath")}


def remember_last(item):
    """Keep the most recent item with artwork so the bar chip can show its
    cover before the first poll after a shell restart, and while idle."""
    if not item or not item.get("artPath"):
        return
    previous = load_last()
    if previous.get("uri") == item.get("uri") and previous.get("artPath") == item.get("artPath"):
        return
    blob = json.dumps({"uri": item.get("uri", ""), "name": item.get("name", ""),
                       "subtitle": item.get("artists") or item.get("show") or item.get("book") or "",
                       "art": item.get("art", ""), "artPath": item["artPath"]}).encode("utf-8")
    try:
        with state_dir(create=True) as held:
            write_file_at(held, "last-played.json", blob, 0o600)
            unlink_at(held, "last-played.json.tmp")
    except (OSError, ApiError):
        pass


def mask(value):
    value = str(value or "")
    if len(value) <= 8:
        return "•" * len(value)
    return value[:4] + "…" + value[-4:]


# ------------------------------------------------------------------ http core

class ResponseTooLarge(ApiError):
    def __init__(self, limit):
        super().__init__("too_large", "Spotify sent a reply larger than %d bytes; it was refused" % limit)


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """Never follow a redirect. The Web API, the token endpoint and the image
    CDN all answer directly; following one would copy the bearer token onto the
    new request and read the redirect body without a limit."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None


def build_opener(allow_plain_http=False):
    """An opener with HTTPS and nothing else: no proxies taken from the
    environment, no redirects, no file:, ftp: or data: handlers."""
    opener = urllib.request.OpenerDirector()
    handlers = [
        urllib.request.UnknownHandler(),
        urllib.request.HTTPDefaultErrorHandler(),
        NoRedirect(),
        urllib.request.HTTPErrorProcessor(),
        urllib.request.HTTPSHandler(context=ssl.create_default_context()),
    ]
    if allow_plain_http:  # the test suite's local server only
        handlers.append(urllib.request.HTTPHandler())
    for handler in handlers:
        opener.add_handler(handler)
    return opener


_OPENER = None
_OPENER_LOCK = threading.Lock()


def opener():
    global _OPENER
    with _OPENER_LOCK:
        if _OPENER is None:
            _OPENER = build_opener()
        return _OPENER


def read_bounded(stream, limit, headers=None, deadline=None):
    """A whole HTTP body, but never more than `limit` bytes: refused up front
    when Content-Length already exceeds it, otherwise read in chunks and
    abandoned at the first byte past it. `deadline` (time.monotonic) bounds
    the whole read, so a server trickling bytes under the socket timeout still
    cannot hold the bridge open."""
    length = headers.get("Content-Length") if headers is not None else None
    if length is not None:
        try:
            declared = int(str(length).strip())
        except ValueError:
            declared = -1
        if declared > limit:
            raise ResponseTooLarge(limit)
    read = getattr(stream, "read1", None) or stream.read
    chunks = []
    total = 0
    while True:
        if deadline is not None and time.monotonic() > deadline:
            raise ApiError("network", "Spotify took too long to answer")
        chunk = read(min(65536, limit + 1 - total))
        if not chunk:
            break
        chunks.append(chunk)
        total += len(chunk)
        if total > limit:
            raise ResponseTooLarge(limit)
    return b"".join(chunks)


def http_raw(method, url, headers=None, data=None, timeout=HTTP_TIMEOUT, limit=API_MAX_BYTES):
    """Return (status, body_bytes, headers). Never raises for HTTP status codes;
    raises ApiError for transport failures and for any body — success or error
    — over its cap."""
    req = urllib.request.Request(url, data=data, method=method)
    req.add_header("User-Agent", USER_AGENT)
    for key, value in (headers or {}).items():
        req.add_header(key, value)
    deadline = time.monotonic() + 2 * timeout
    try:
        with opener().open(req, timeout=timeout) as resp:
            return resp.status, read_bounded(resp, limit, resp.headers, deadline), dict(resp.headers)
    except urllib.error.HTTPError as err:
        try:
            body = read_bounded(err, min(limit, ERROR_MAX_BYTES), err.headers, deadline)
        except (OSError, http_client.HTTPException):
            body = b""
        finally:
            err.close()
        return err.code, body, dict(err.headers or {})
    except urllib.error.URLError as err:
        raise ApiError("network", "Spotify is unreachable: %s" % getattr(err, "reason", err))
    except (TimeoutError, OSError, http_client.HTTPException) as err:
        raise ApiError("network", "Spotify request failed (%s)" % err)


def http(method, url, headers=None, data=None, timeout=HTTP_TIMEOUT, limit=API_MAX_BYTES):
    """Return (status, body_text, headers); see http_raw."""
    status, body, resp_headers = http_raw(method, url, headers, data, timeout, limit)
    return status, body.decode("utf-8", "replace"), resp_headers


def token_request(form):
    body = urllib.parse.urlencode(form).encode("utf-8")
    status, text, _ = http("POST", ACCOUNTS + "/api/token",
                           {"Content-Type": "application/x-www-form-urlencoded"}, body)
    try:
        payload = json.loads(text) if text else {}
    except ValueError:
        payload = {}
    if status != 200:
        code = payload.get("error", "token_error")
        desc = payload.get("error_description") or ("Token request failed (HTTP %d)" % status)
        raise ApiError(code, desc, status)
    return payload


def store_tokens(auth, payload):
    auth["access_token"] = payload.get("access_token", "")
    if payload.get("refresh_token"):
        auth["refresh_token"] = payload["refresh_token"]
    auth["expires_at"] = time.time() + float(payload.get("expires_in", 3600))
    auth["scope"] = payload.get("scope", auth.get("scope", ""))
    auth.pop("needs_reauth", None)
    save_auth(auth)


def access_token(auth, force_refresh=False):
    if not auth.get("refresh_token"):
        raise ApiError("signed_out", "Not connected to Spotify")
    if auth.get("needs_reauth"):
        raise ApiError("reauth", "Spotify session expired — connect again")
    if not force_refresh and auth.get("access_token") and time.time() < float(auth.get("expires_at", 0)) - 45:
        return auth["access_token"]
    try:
        payload = token_request({
            "grant_type": "refresh_token",
            "refresh_token": auth["refresh_token"],
            "client_id": auth.get("client_id", ""),
        })
    except ApiError as err:
        if err.code in ("invalid_grant", "invalid_client", "unauthorized_client"):
            auth["needs_reauth"] = True
            save_auth(auth)
            raise ApiError("reauth", "Spotify session expired — connect again")
        raise
    store_tokens(auth, payload)
    return auth["access_token"]


def api(method, path, params=None, body=None, auth=None, _retried=False):
    """Call the Web API. Returns parsed JSON, or None for empty (204) replies."""
    if auth is None:
        auth = load_auth()
    token = access_token(auth)
    url = API + path
    if params:
        clean = {k: v for k, v in params.items() if v is not None and v != ""}
        if clean:
            url += "?" + urllib.parse.urlencode(clean)
    headers = {"Authorization": "Bearer " + token}
    data = None
    if body is not None:
        headers["Content-Type"] = "application/json"
        data = json.dumps(body).encode("utf-8")
    status, text, resp_headers = http(method, url, headers, data)

    if status in (200, 201, 202, 204):
        if not text.strip():
            return None
        try:
            return json.loads(text)
        except ValueError:
            return None

    try:
        payload = json.loads(text) if text else {}
    except ValueError:
        payload = {}
    err = payload.get("error") if isinstance(payload, dict) else None
    reason = ""
    message = ""
    if isinstance(err, dict):
        reason = str(err.get("reason") or "")
        message = str(err.get("message") or "")
    elif isinstance(err, str):
        message = err

    if status == 401 and not _retried:
        access_token(auth, force_refresh=True)
        return api(method, path, params, body, auth, _retried=True)
    if status == 401:
        raise ApiError("reauth", message or "Spotify rejected the session — connect again", status)
    if status == 403:
        if reason == "PREMIUM_REQUIRED" or "premium" in message.lower():
            raise ApiError("premium_required", "Spotify Premium is required for playback control", status)
        raise ApiError("forbidden", message or "Spotify refused the request", status)
    if status == 404:
        if reason == "NO_ACTIVE_DEVICE" or "device" in message.lower():
            raise ApiError("no_device", "No active Spotify device", status)
        raise ApiError("not_found", message or "Not found", status)
    if status == 429:
        try:
            retry_after = int(resp_headers.get("Retry-After") or resp_headers.get("retry-after") or 0)
        except ValueError:
            retry_after = 0
        raise ApiError("rate_limited", "Spotify rate limit hit — retry in %ds" % max(retry_after, 1), status, retry_after)
    if status >= 500:
        raise ApiError("server", message or ("Spotify server error (HTTP %d)" % status), status)
    raise ApiError("http_%d" % status, message or ("Spotify request failed (HTTP %d)" % status), status)


def paged(path, params, limit_total, item_key="items"):
    """Walk a paginated collection endpoint until `limit_total` items or the end."""
    items = []
    offset = 0
    page = int(params.get("limit", 50))
    total = None
    while len(items) < limit_total:
        query = dict(params)
        query["offset"] = offset
        payload = api("GET", path, query) or {}
        batch = payload.get(item_key) or []
        items.extend(batch)
        total = payload.get("total")
        if not batch or len(batch) < page or not payload.get("next"):
            break
        offset += len(batch)
    return items, total


# ----------------------------------------------------------------- artwork

def art_url(images, prefer):
    """Pick the smallest image at least `prefer` px wide, else the largest."""
    if not isinstance(images, list) or not images:
        return ""
    sized = [i for i in images if isinstance(i, dict) and i.get("url")]
    if not sized:
        return ""
    candidates = sorted(sized, key=lambda i: int(i.get("width") or i.get("height") or 0))
    for image in candidates:
        if int(image.get("width") or image.get("height") or 0) >= prefer:
            return image["url"]
    return candidates[-1]["url"]


def art_url_allowed(url):
    """HTTPS to Spotify's image CDNs on the default port, no credentials."""
    try:
        parts = urllib.parse.urlsplit(str(url or ""))
        port = parts.port
    except ValueError:
        return False
    return (parts.scheme == "https" and not parts.username and not parts.password
            and port in (None, 443) and bool(ART_HOST_RE.match(parts.hostname or "")))


_ART_DIR = None
_ART_DIR_LOCK = threading.Lock()


def art_dir():
    """The cover cache, held open for the life of the process so the download
    workers all write relative to one checked descriptor."""
    global _ART_DIR
    with _ART_DIR_LOCK:
        if _ART_DIR is None:
            _ART_DIR = open_dir(xdg_home("XDG_CACHE_HOME", ".cache"), ("omarchy-spotify", "art"), create=True)
        return _ART_DIR


def cache_one(url):
    if not art_url_allowed(url):
        return ""
    name = hashlib.sha1(url.encode("utf-8")).hexdigest()[:28] + ".jpg"
    try:
        held = art_dir()
        try:
            st = os.stat(name, dir_fd=held.fd, follow_symlinks=False)
        except FileNotFoundError:
            st = None
        if st is not None:
            if (stat.S_ISREG(st.st_mode) and st.st_uid == os.geteuid() and st.st_nlink == 1
                    and not st.st_mode & 0o022 and 0 < st.st_size <= ART_MAX_BYTES):
                return held.entry(name)
            # Anything else under that name — a symlink, a FIFO, somebody
            # else's file — is taken out and the cover fetched again.
            unlink_at(held, name)
        status, blob, _ = http_raw("GET", url, timeout=ART_TIMEOUT, limit=ART_MAX_BYTES)
        if status != 200 or not blob:
            return ""
        write_file_at(held, name, blob, 0o600)
        return held.entry(name)
    except Exception:
        return ""


def cache_art(items):
    """Fill `artPath` on every dict in `items` (recursing one level into `items`
    lists) by downloading their `art` URLs concurrently."""
    targets = []

    def collect(obj):
        if isinstance(obj, dict):
            if obj.get("art") and not obj.get("artPath"):
                targets.append(obj)
            for value in obj.values():
                if isinstance(value, (list, dict)):
                    collect(value)
        elif isinstance(obj, list):
            for value in obj:
                collect(value)

    collect(items)
    if not targets:
        return items
    urls = sorted({t["art"] for t in targets})
    with ThreadPoolExecutor(max_workers=ART_WORKERS) as pool:
        paths = dict(zip(urls, pool.map(cache_one, urls)))
    for target in targets:
        target["artPath"] = paths.get(target["art"], "")
    return items


# -------------------------------------------------------------- normalizers

def names(entries):
    if not isinstance(entries, list):
        return ""
    return ", ".join(str(e.get("name", "")) for e in entries if isinstance(e, dict) and e.get("name"))


def short(text, limit=220):
    text = " ".join(str(text or "").split())
    return text if len(text) <= limit else text[: limit - 1].rstrip() + "…"


def resume(obj):
    point = obj.get("resume_point") if isinstance(obj, dict) else None
    if not isinstance(point, dict):
        return 0, False
    return int(point.get("resume_position_ms") or 0), bool(point.get("fully_played"))


def norm_track(t, art_size=64):
    if not isinstance(t, dict):
        return None
    album = t.get("album") if isinstance(t.get("album"), dict) else {}
    return {
        "type": "track",
        "id": t.get("id", ""),
        "uri": t.get("uri", ""),
        "name": t.get("name", ""),
        "artists": names(t.get("artists")),
        "album": album.get("name", ""),
        "albumUri": album.get("uri", ""),
        "durationMs": int(t.get("duration_ms") or 0),
        "explicit": bool(t.get("explicit")),
        "art": art_url(album.get("images"), art_size),
        "playable": t.get("is_playable", True) is not False,
    }


def norm_episode(e, art_size=64, parent=None):
    if not isinstance(e, dict):
        return None
    show = e.get("show") if isinstance(e.get("show"), dict) else (parent or {})
    resume_ms, played = resume(e)
    return {
        "type": "episode",
        "id": e.get("id", ""),
        "uri": e.get("uri", ""),
        "name": e.get("name", ""),
        "show": show.get("name", ""),
        "showUri": show.get("uri", ""),
        "durationMs": int(e.get("duration_ms") or 0),
        "releaseDate": e.get("release_date", ""),
        "description": short(e.get("description")),
        "resumeMs": resume_ms,
        "fullyPlayed": played,
        "art": art_url(e.get("images"), art_size) or art_url(show.get("images"), art_size),
    }


def norm_chapter(c, art_size=64, parent=None):
    if not isinstance(c, dict):
        return None
    book = c.get("audiobook") if isinstance(c.get("audiobook"), dict) else (parent or {})
    resume_ms, played = resume(c)
    return {
        "type": "chapter",
        "id": c.get("id", ""),
        "uri": c.get("uri", ""),
        "name": c.get("name", ""),
        "chapterNumber": int(c.get("chapter_number") or 0),
        "book": book.get("name", ""),
        "bookUri": book.get("uri", ""),
        "durationMs": int(c.get("duration_ms") or 0),
        "resumeMs": resume_ms,
        "fullyPlayed": played,
        "art": art_url(c.get("images"), art_size) or art_url(book.get("images"), art_size),
    }


def norm_playlist(p, art_size=64):
    if not isinstance(p, dict):
        return None
    owner = p.get("owner") if isinstance(p.get("owner"), dict) else {}
    counter = p.get("items") if isinstance(p.get("items"), dict) else (p.get("tracks") if isinstance(p.get("tracks"), dict) else {})
    return {
        "type": "playlist",
        "id": p.get("id", ""),
        "uri": p.get("uri", ""),
        "name": p.get("name", ""),
        "owner": owner.get("display_name") or owner.get("id", ""),
        "ownerId": owner.get("id", ""),
        "count": int(counter.get("total") or 0),
        "description": short(p.get("description")),
        "collaborative": bool(p.get("collaborative")),
        "art": art_url(p.get("images"), art_size),
    }


def norm_album(a, art_size=64):
    if not isinstance(a, dict):
        return None
    return {
        "type": "album",
        "id": a.get("id", ""),
        "uri": a.get("uri", ""),
        "name": a.get("name", ""),
        "artists": names(a.get("artists")),
        "year": str(a.get("release_date", ""))[:4],
        "totalTracks": int(a.get("total_tracks") or 0),
        "albumType": a.get("album_type", ""),
        "art": art_url(a.get("images"), art_size),
    }


def norm_artist(a, art_size=64):
    if not isinstance(a, dict):
        return None
    return {
        "type": "artist",
        "id": a.get("id", ""),
        "uri": a.get("uri", ""),
        "name": a.get("name", ""),
        "genres": ", ".join((a.get("genres") or [])[:2]),
        "art": art_url(a.get("images"), art_size),
    }


def norm_show(s, art_size=64):
    if not isinstance(s, dict):
        return None
    return {
        "type": "show",
        "id": s.get("id", ""),
        "uri": s.get("uri", ""),
        "name": s.get("name", ""),
        "publisher": s.get("publisher", ""),
        "totalEpisodes": int(s.get("total_episodes") or 0),
        "description": short(s.get("description")),
        "art": art_url(s.get("images"), art_size),
    }


def norm_audiobook(b, art_size=64):
    if not isinstance(b, dict):
        return None
    return {
        "type": "audiobook",
        "id": b.get("id", ""),
        "uri": b.get("uri", ""),
        "name": b.get("name", ""),
        "authors": names(b.get("authors")),
        "narrators": names(b.get("narrators")),
        "totalChapters": int(b.get("total_chapters") or 0),
        "description": short(b.get("description")),
        "art": art_url(b.get("images"), art_size),
    }


def norm_any(obj, art_size=64):
    kind = obj.get("type") if isinstance(obj, dict) else ""
    if kind == "track":
        return norm_track(obj, art_size)
    if kind == "episode":
        return norm_episode(obj, art_size)
    if kind == "chapter":
        return norm_chapter(obj, art_size)
    if kind == "album":
        return norm_album(obj, art_size)
    if kind == "artist":
        return norm_artist(obj, art_size)
    if kind == "playlist":
        return norm_playlist(obj, art_size)
    if kind == "show":
        return norm_show(obj, art_size)
    if kind == "audiobook":
        return norm_audiobook(obj, art_size)
    return None


def norm_device(d):
    if not isinstance(d, dict):
        return None
    return {
        "id": d.get("id", ""),
        "name": d.get("name", ""),
        "kind": d.get("type", ""),
        "isActive": bool(d.get("is_active")),
        "isRestricted": bool(d.get("is_restricted")),
        "volume": int(d.get("volume_percent") or 0) if d.get("volume_percent") is not None else -1,
        "supportsVolume": bool(d.get("supports_volume", True)),
    }


# -------------------------------------------------------------- subcommands

def run_tool(argv, timeout=3):
    """Run a resolved absolute command with the closed child environment.
    Returns (returncode, stdout) and (1, "") when it cannot run at all."""
    if not argv or not argv[0].startswith("/"):
        return 1, ""
    try:
        done = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              timeout=timeout, env=child_env())
        return done.returncode, done.stdout.strip()[:4096]
    except Exception:
        return 1, ""


def quiet_ok(argv):
    return run_tool(argv)[0] == 0


SOLOIST_UNIT = "soloist"
SOLOIST_SERVICE = "soloist.service"
# Soloist takes its API key one way only: `-k/--api-key KEY` on the command
# line. There is no environment variable, no key file, no file descriptor and
# no config file (verified against the shipped binary and against Spotify's
# command-line reference), and Soloist does not scrub its own argv, so the key
# stays readable in /proc/PID/cmdline for the life of the process. A unit this
# plugin generated would therefore have to expand the secret into ExecStart.
# It no longer generates one: the service around Soloist is the user's to
# write or to get from a package, exactly as the binary itself is. Everything
# below only inspects and controls what is already there.
KEY_ARGV_FLAGS = ("-k", "--api-key")
# Stamped into the unit files older versions of this plugin wrote, so "Remove
# Soloist" only ever deletes a unit this plugin created and never one from a
# package.
UNIT_MARKER = "# Managed by the ninepointlabs.spotify Omarchy plugin"
# Units this plugin wrote before the marker existed carried no stamp. Recognise
# them by the shape they always had, so an upgrade can still find and remove
# them instead of mistaking them for a unit from a package. Both shapes carry
# the key in ExecStart, which is why the panel now offers to take them off.
LEGACY_UNIT_FINGERPRINT = (
    "Documentation=https://developer.spotify.com/documentation/soloist",
    "--ws 127.0.0.1:0",
)
# The weekly re-download timer an earlier version of this plugin installed.
# That path is gone; these names survive only so the plugin can take the units
# back off machines that still have them. Nothing re-creates them.
LEGACY_UPDATE_UNITS = ["soloist-update.service", "soloist-update.timer"]
LEGACY_UPDATER_NAME = "soloist-update"

SOLOIST_MISSING_HINT = (
    "No soloist binary found. Install Spotify Soloist yourself: on Arch/Omarchy the AUR "
    "package spotify-soloist-bin, otherwise the download linked from "
    "https://developer.spotify.com/documentation/soloist, unpacked into ~/.local/bin. "
    "This plugin deliberately does not fetch it — Spotify publishes no checksum and no "
    "signature for those builds, so a download could not be verified against anything."
)

SOLOIST_UNIT_HINT = (
    "No soloist.service found. Install Soloist's service from your package, or write "
    "your own unit for it — the plugin no longer generates one, because Soloist accepts "
    "its API key only as a command-line argument and a generated unit would have to put "
    "that secret into the process command line. See the README section \"Running Soloist "
    "yourself\"."
)


def config_home():
    return xdg_home("XDG_CONFIG_HOME", ".config")


def systemd_user_dir(create=False):
    return open_dir(os.path.join(config_home(), "systemd", "user"), (), create)


def user_bin_dir():
    return open_dir(os.path.join(home(), ".local", "bin"))


def read_our_unit():
    """Text of ~/.config/systemd/user/soloist.service, or None when it is
    absent or is not a plain file you own (a symlink into a package's unit is
    never read as, or treated as, ours)."""
    try:
        with systemd_user_dir() as held:
            blob = read_file_at(held, SOLOIST_SERVICE, UNIT_MAX_BYTES, private=False)
    except (OSError, ApiError):
        return None
    return None if blob is None else blob.decode("utf-8", "replace")


def our_unit_exists():
    try:
        with systemd_user_dir() as held:
            return lexists_at(held, SOLOIST_SERVICE)
    except (OSError, ApiError):
        return False


def unit_is_ours():
    """True when ~/.config/systemd/user/soloist.service is a file this plugin
    wrote. A unit from a package (which lives under /usr) or one the user wrote
    by hand is never ours to rewrite or delete."""
    body = read_our_unit()
    return body is not None and (UNIT_MARKER in body or all(line in body for line in LEGACY_UNIT_FINGERPRINT))


def find_soloist():
    """Locate a soloist binary the user installed themselves: a package in a
    trusted system directory first, then an unpacked copy in ~/.local/bin. That
    copy is accepted only as a regular executable owned by you (or root), with
    nobody else able to write to it or to any directory leading to it —
    wherever a symlink there points. The session PATH is never searched. The
    plugin only ever reads this; it never downloads, installs or replaces the
    binary."""
    path = trusted_tool("soloist")
    if path:
        return path
    local = os.path.join(home(), ".local", "bin", "soloist")
    return local if user_executable(local) else ""


def systemctl_user(*args):
    tool = trusted_tool("systemctl")
    if not tool:
        return 1, ""
    return run_tool([tool, "--user"] + list(args))


def legacy_updater_present():
    try:
        with systemd_user_dir() as held:
            if any(lexists_at(held, unit) for unit in LEGACY_UPDATE_UNITS):
                return True
    except (OSError, ApiError):
        pass
    try:
        with user_bin_dir() as held:
            return lexists_at(held, LEGACY_UPDATER_NAME)
    except (OSError, ApiError):
        return False


def unit_properties(*names):
    """Several `systemctl --user show` properties of soloist.service in one
    subprocess. The status poll wants four or five of these, and spawning
    systemctl once per property adds up at a four-second poll interval."""
    args = []
    for name in names:
        args += ["-p", name]
    code, text = systemctl_user("show", *(args + [SOLOIST_SERVICE]))
    props = dict.fromkeys(names, "")
    if code != 0:
        return props
    for line in text.splitlines():
        name, sep, value = line.partition("=")
        if sep and name in props:
            props[name] = value.strip()
    return props


def redact_argv(argv):
    """An argument vector with every API key blanked out, so a finding can be
    shown or logged without reprinting the secret it is complaining about."""
    safe, skip = [], False
    for arg in argv:
        if skip:
            safe.append("<redacted>")
            skip = False
            continue
        head = arg.split("=", 1)[0]
        if arg in KEY_ARGV_FLAGS:
            safe.append(arg)
            skip = True
        elif head in KEY_ARGV_FLAGS:
            safe.append(head + "=<redacted>")
        else:
            safe.append(arg)
    return safe


def argv_carries_key(argv):
    """True when this command line hands Soloist an API key. Both spellings
    Soloist accepts count: a flag with the key as the next argument, and the
    joined `--api-key=KEY` form."""
    for i, arg in enumerate(argv):
        if arg in KEY_ARGV_FLAGS and i + 1 < len(argv):
            return True
        if arg.split("=", 1)[0] in KEY_ARGV_FLAGS and "=" in arg:
            return True
    return False


def unit_exec_argv(exec_start):
    """The argument vector systemd is configured to run, pulled out of the
    `ExecStart` property. Variables are still unexpanded there
    (`${SOLOIST_API_KEY}` rather than the key), which is exactly what makes
    this safe to read: it shows the *shape* of the command line without the
    secret in it."""
    marker = "argv[]="
    if marker not in (exec_start or ""):
        return []
    return exec_start.split(marker, 1)[1].split(" ; ", 1)[0].strip().split()


def live_soloist_argv(pids=None):
    """Every running Soloist command line this user can see, as (pid, argv).

    Read straight out of /proc, which is where the exposure actually lives:
    whatever is in argv here is what `ps`, a crash report or a bug-report paste
    would carry. When `pids` is given only those are read (the unit's MainPID
    during a status poll); otherwise the whole process table is swept."""
    found = []
    try:
        entries = [str(int(pid)) for pid in pids] if pids is not None \
            else [name for name in os.listdir(PROC_DIR) if name.isdigit()]
    except (OSError, TypeError, ValueError):
        return found
    for name in entries:
        try:
            with open(os.path.join(PROC_DIR, name, "cmdline"), "rb") as fh:
                raw = fh.read(CMDLINE_MAX_BYTES)
        except OSError:
            continue
        argv = [part.decode("utf-8", "replace") for part in raw.split(b"\0") if part]
        if argv and os.path.basename(argv[0]) == "soloist":
            found.append((int(name), argv))
    return found


def soloist_key_exposed(props):
    """The cheap form of the audit, run on every status poll: does the unit
    systemd would start, or the Soloist process it is running right now, carry
    the API key on its command line? Only the unit's own properties and its
    main process are read here — the full sweep belongs to `soloist audit`.

    Nothing this plugin writes can make this true any more, but a unit from a
    package or one the user wrote by hand still can, and the panel says so
    rather than staying quiet about it."""
    if argv_carries_key(unit_exec_argv(props.get("ExecStart"))):
        return True
    main_pid = props.get("MainPID") or ""
    if not main_pid.isdigit() or main_pid == "0":
        return False
    return any(argv_carries_key(argv) for _, argv in live_soloist_argv([main_pid]))


def soloist_argv_audit():
    """The full check the marketplace review asks for: read the live unit and
    process metadata and report whether a Soloist API key is reachable from a
    command line. Values are never returned — only where a key argument was
    found, with the argument vectors redacted."""
    findings = []
    props = unit_properties("FragmentPath", "ExecStart")
    unit_argv = unit_exec_argv(props["ExecStart"])
    if argv_carries_key(unit_argv):
        findings.append({
            "source": "unit",
            "where": props["FragmentPath"] or SOLOIST_SERVICE,
            "argv": redact_argv(unit_argv),
        })
    live = live_soloist_argv()
    for pid, argv in live:
        if argv_carries_key(argv):
            findings.append({
                "source": "process",
                "where": "/proc/%d/cmdline" % pid,
                "argv": redact_argv(argv),
            })
    return {
        # Nothing in this plugin writes a unit or stores a key, so a finding
        # here is always something outside the reviewed snapshot.
        "pluginWritesUnit": False,
        "pluginStoresKey": False,
        "unitChecked": bool(unit_argv),
        "processesChecked": len(live),
        "legacyPluginUnit": unit_is_ours(),
        "keyInCommandLine": bool(findings),
        "findings": findings,
    }


def soloist_state():
    """Spotify Soloist — Spotify's own headless Connect client. librespot-based
    daemons (spotifyd, spotify-player) no longer get audio keys for newer
    accounts, so Soloist is what the panel drives. The user installs the
    binary. The service that runs it is the user's too — see the note above
    KEY_ARGV_FLAGS — so this plugin only finds both and reports on them."""
    binary = find_soloist()
    # A unit may have come from an older version of this plugin
    # (~/.config/systemd/user) or from a package the user installed. Only the
    # first kind is ours to delete — and it is now only ever deleted, never
    # written, because it carries the API key in ExecStart.
    props = unit_properties("FragmentPath", "ExecStart", "ExecMainStatus", "MainPID", "ActiveState")
    unit_exists = bool(props["FragmentPath"]) or our_unit_exists()
    legacy_unit = unit_is_ours()
    running = bool(binary) and props["ActiveState"] == "active"
    expired = bool(binary) and not running and props["ExecMainStatus"] == "10"
    paired = False
    try:
        with open_dir(os.path.join(xdg_home("XDG_DATA_HOME", ".local", "share"), "soloist")) as held:
            paired = any(not name.startswith("ws.") for name in os.listdir(held.fd))
    except (OSError, ApiError):
        paired = False
    return {
        "daemonName": "Soloist",
        "daemonInstalled": bool(binary),
        "daemonPath": binary,
        "daemonUnit": unit_exists,
        # A key-bearing unit left behind by an older version of this plugin.
        # The panel offers to remove it; nothing re-creates it.
        "daemonLegacyUnit": legacy_unit,
        # True when the unit systemd would start, or the Soloist process it is
        # running, passes the API key as a command-line argument. Never true
        # for anything this plugin wrote, since it writes no unit at all.
        "daemonKeyInCommandLine": soloist_key_exposed(props),
        "daemonRunning": running,
        "daemonExpired": expired,
        "daemonPaired": paired,
        # True while a machine still carries the weekly re-download timer an
        # earlier version of this plugin installed, so the panel can offer to
        # take it off.
        "legacyUpdater": legacy_updater_present(),
    }


def launch_tools():
    """Absolute paths the panel starts detached programs through (the app
    launcher, Omarchy's focus and floating-terminal scripts). Resolved here
    from the trusted directories only; Model.js validates them again before
    any of them is used as a command."""
    return {
        "uwsm-app": trusted_tool("uwsm-app"),
        "omarchy-launch-or-focus": trusted_tool("omarchy-launch-or-focus", TRUSTED_OMARCHY_DIRS),
        "omarchy-launch-floating-terminal-with-presentation":
            trusted_tool("omarchy-launch-floating-terminal-with-presentation", TRUSTED_OMARCHY_DIRS),
    }


def app_state():
    """The desktop app and the headless Soloist daemon are the two local
    Spotify Connect devices the panel knows how to start."""
    binary = trusted_tool("spotify") or trusted_tool("spotify-launcher")
    pgrep = trusted_tool("pgrep")
    running = bool(binary) and bool(pgrep) and quiet_ok([pgrep, "-x", "spotify"])
    state = {
        "appBinary": binary,
        "appInstalled": bool(binary),
        "appRunning": running,
        "tools": launch_tools(),
    }
    state.update(soloist_state())
    return state


def cmd_status(args):
    auth = load_auth()
    data = {
        "configured": bool(auth.get("client_id")),
        "clientId": auth.get("client_id", ""),
        "clientIdMasked": mask(auth.get("client_id", "")),
        "authenticated": bool(auth.get("refresh_token")) and not auth.get("needs_reauth"),
        "needsReauth": bool(auth.get("needs_reauth")),
        "user": auth.get("user") or {},
        "authorizedAt": auth.get("authorized_at", 0),
        "lastPlayed": load_last(),
    }
    data.update(app_state())
    out(data)


def remove_our_unit():
    try:
        with systemd_user_dir() as held:
            return unlink_at(held, SOLOIST_SERVICE)
    except (OSError, ApiError):
        return False


def drop_legacy_updater():
    """Take the weekly re-download timer an earlier version of this plugin
    installed back off. Nothing in the plugin re-creates it."""
    systemctl_user("disable", "--now", "--quiet", "soloist-update.timer", "soloist-update.service")
    removed = False
    try:
        with systemd_user_dir() as held:
            for unit in LEGACY_UPDATE_UNITS:
                removed = unlink_at(held, unit) or removed
    except (OSError, ApiError):
        pass
    try:
        with user_bin_dir() as held:
            removed = unlink_at(held, LEGACY_UPDATER_NAME) or removed
    except (OSError, ApiError):
        pass
    if removed:
        systemctl_user("daemon-reload")
    return removed


def cmd_soloist(args):
    """Inspect what is already installed around Soloist, take this plugin's own
    leftovers back off, and audit the live command line for the API key.

    There is deliberately no install, no setup and no key action. Soloist reads
    its API key only from `-k/--api-key` on the command line — no environment
    variable, no key file, no file descriptor, no config file — and it does not
    scrub its argv afterwards, so anything that starts Soloist with a key puts
    that key where `ps`, `systemctl status`, a crash report or a pasted log can
    pick it up. A unit generated here could not avoid that, so the plugin does
    not generate one and never stores the key. Writing the service, like
    installing the binary, is left to a package or to the user."""
    verb = args.action
    if verb == "audit":
        # The check the marketplace review asks for: live unit and process
        # metadata, reported without the secret it is looking for.
        state = app_state()
        state["audit"] = soloist_argv_audit()
        out(state)
    elif verb == "remove":
        # Only what this plugin created: a unit an older version of it wrote
        # (which carries the key in ExecStart), plus any leftovers of the old
        # updater. The binary and any unit from a package belong to the user
        # and are never touched.
        if not unit_is_ours():
            return fail("not_ours", "This soloist.service did not come from the plugin, so it is "
                                    "left alone. Remove it the way you installed it.", app_state())
        systemctl_user("disable", "--now", "--quiet", SOLOIST_UNIT)
        remove_our_unit()
        drop_legacy_updater()
        systemctl_user("daemon-reload")
        out(app_state())
    elif verb == "drop-updater":
        dropped = drop_legacy_updater()
        state = app_state()
        state["updaterRemoved"] = dropped
        out(state)
    else:
        return fail("bad_args", "soloist action must be audit, remove, or drop-updater")


def cmd_daemon(args):
    """Start/stop the Soloist user service so the panel has a device."""
    state = soloist_state()
    if not state["daemonInstalled"]:
        return fail("no_daemon", SOLOIST_MISSING_HINT, state)
    if not state["daemonUnit"]:
        return fail("no_unit", SOLOIST_UNIT_HINT, state)
    verb = args.action
    if verb not in ("start", "stop", "restart"):
        return fail("bad_args", "daemon action must be start, stop, or restart")
    ok = systemctl_user(verb, SOLOIST_UNIT)[0] == 0
    if ok and verb == "start":
        systemctl_user("enable", "--quiet", SOLOIST_UNIT)
    if not ok:
        return fail("daemon_failed", "systemctl --user %s soloist failed — check `journalctl --user -u soloist`" % verb)
    time.sleep(1.0)
    out(app_state())


# The login listener reads at most this much of any request — request line and
# headers together — and gives a silent peer this long per socket operation.
LISTENER_MAX_REQUEST_BYTES = 16 * 1024
LISTENER_SOCKET_TIMEOUT = 5
AUTH_CODE_RE = re.compile(r"^[A-Za-z0-9_-]{1,2048}$")


class CappedReader:
    """The listener's view of a request stream: `limit` bytes in total, however
    much the peer sends. http.server otherwise accepts a 64 KiB request line
    plus a hundred 64 KiB header lines."""

    def __init__(self, raw, limit):
        self.raw = raw
        self.left = limit

    def _budget(self, size):
        return self.left if size is None or size < 0 else min(size, self.left)

    def readline(self, size=-1):
        budget = self._budget(size)
        if budget <= 0:
            return b""
        line = self.raw.readline(budget)
        self.left -= len(line)
        return line

    def read(self, size=-1):
        budget = self._budget(size)
        if budget <= 0:
            return b""
        data = self.raw.read(budget)
        self.left -= len(data)
        return data

    def close(self):
        self.raw.close()


class CallbackHandler(BaseHTTPRequestHandler):
    result = {}
    expected_state = ""
    timeout = LISTENER_SOCKET_TIMEOUT

    def setup(self):
        super().setup()
        self.rfile = CappedReader(self.rfile, LISTENER_MAX_REQUEST_BYTES)

    def log_message(self, fmt, *args):  # silence the default stderr chatter
        pass

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path != "/callback":
            self.send_response(404)
            self.end_headers()
            return
        query = urllib.parse.parse_qs(parsed.query)
        state = (query.get("state") or [""])[0]
        code = (query.get("code") or [""])[0]
        if not secrets.compare_digest(state.encode("utf-8"), CallbackHandler.expected_state.encode("utf-8")):
            # Any web page can point the browser here. A request without this
            # login's state neither completes nor cancels it; keep waiting.
            body = "Login response did not match this request. Try connecting again."
        elif query.get("error"):
            # Anything from the query string is untrusted: a page could send the
            # browser here. Keep it short and escape it before it hits HTML.
            reason = query["error"][0][:80]
            CallbackHandler.result = {"error": reason}
            body = "Spotify reported: %s. You can close this tab." % html.escape(reason)
        elif not AUTH_CODE_RE.match(code):
            CallbackHandler.result = {"error": "malformed_code"}
            body = "Login response was malformed. Try connecting again."
        else:
            CallbackHandler.result = {"code": code}
            body = "Connected to Spotify. You can close this tab and go back to your bar."
        page = ("<!doctype html><meta charset=utf-8><title>Omarchy Spotify</title>"
                "<body style=\"font-family:monospace;background:#101315;color:#cacccc;display:flex;"
                "align-items:center;justify-content:center;height:100vh;margin:0\">"
                "<div style=\"text-align:center\"><div style=\"font-size:48px\">&#9835;</div>"
                "<p>%s</p></div></body>" % body).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(page)))
        self.end_headers()
        self.wfile.write(page)


def cmd_auth(args):
    client_id = (args.client_id or load_auth().get("client_id") or "").strip()
    if not client_id:
        return fail("no_client_id", "A Spotify app Client ID is required")
    port = int(args.port)
    if not 1024 <= port <= 65535:
        return fail("bad_args", "The redirect port must be between 1024 and 65535")
    redirect_uri = "http://127.0.0.1:%d/callback" % port

    verifier = base64.urlsafe_b64encode(secrets.token_bytes(64)).decode("ascii").rstrip("=")
    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode("ascii")).digest()).decode("ascii").rstrip("=")
    state = secrets.token_urlsafe(16)
    CallbackHandler.expected_state = state
    CallbackHandler.result = {}

    try:
        server = HTTPServer(("127.0.0.1", port), CallbackHandler)
    except OSError as err:
        return fail("port_busy", "Port %d is busy (%s) — pick another redirect port" % (port, err))
    server.timeout = 1

    authorize_url = ACCOUNTS + "/authorize?" + urllib.parse.urlencode({
        "client_id": client_id,
        "response_type": "code",
        "redirect_uri": redirect_uri,
        "code_challenge_method": "S256",
        "code_challenge": challenge,
        "state": state,
        "scope": " ".join(SCOPES),
    })

    if args.print_url:
        sys.stderr.write(authorize_url + "\n")
    if not args.no_browser:
        browser = trusted_tool("xdg-open") or trusted_tool("omarchy-launch-browser", TRUSTED_OMARCHY_DIRS)
        if browser:
            try:
                subprocess.Popen([browser, authorize_url], start_new_session=True, env=child_env(display=True),
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError:
                pass

    deadline = time.time() + int(args.timeout)
    try:
        while time.time() < deadline and not CallbackHandler.result:
            server.handle_request()
    finally:
        server.server_close()

    result = CallbackHandler.result
    if not result:
        return fail("timeout", "Timed out waiting for Spotify to redirect back", {"authorizeUrl": authorize_url})
    if result.get("error"):
        return fail("denied", "Spotify login failed: %s" % re.sub(r"[^A-Za-z0-9_ .-]", "", result["error"]))

    payload = token_request({
        "grant_type": "authorization_code",
        "code": result["code"],
        "redirect_uri": redirect_uri,
        "client_id": client_id,
        "code_verifier": verifier,
    })
    auth = {"client_id": client_id, "redirect_port": port, "authorized_at": time.time()}
    store_tokens(auth, payload)
    try:
        me = api("GET", "/me", auth=auth) or {}
        auth["user"] = {"id": me.get("id", ""), "name": me.get("display_name") or me.get("id", ""),
                        "art": art_url(me.get("images"), 64)}
        save_auth(auth)
    except ApiError:
        pass
    out({"authenticated": True, "user": auth.get("user") or {}})


def cmd_logout(args):
    clear_auth()
    out({"authenticated": False})


def cmd_me(args):
    me = api("GET", "/me") or {}
    out({"id": me.get("id", ""), "name": me.get("display_name") or me.get("id", ""), "art": art_url(me.get("images"), 64)})


def cmd_player(args):
    state = api("GET", "/me/player", {"additional_types": "track,episode"})
    if not state:
        out({"active": False, "fetchedAt": int(time.time() * 1000)})
        return
    item = norm_any(state.get("item") or {}, 300)
    if item:
        cache_art([item])
        remember_last(item)
    device = norm_device(state.get("device")) or {}
    context = state.get("context") if isinstance(state.get("context"), dict) else {}
    data = {
        "active": True,
        "fetchedAt": int(time.time() * 1000),
        "isPlaying": bool(state.get("is_playing")),
        "progressMs": int(state.get("progress_ms") or 0),
        "shuffle": bool(state.get("shuffle_state")),
        "repeat": state.get("repeat_state") or "off",
        "device": device,
        "volume": device.get("volume", -1),
        "context": {"uri": context.get("uri", ""), "type": context.get("type", "")},
        "item": item,
        "actions": (state.get("actions") or {}).get("disallows") or {},
    }
    out(data)


def cmd_devices(args):
    payload = api("GET", "/me/player/devices") or {}
    devices = [d for d in (norm_device(x) for x in payload.get("devices") or []) if d]
    out(devices)


def first_device_id():
    payload = api("GET", "/me/player/devices") or {}
    devices = [d for d in (norm_device(x) for x in payload.get("devices") or []) if d and d.get("id")]
    if not devices:
        return ""
    for d in devices:
        if d["isActive"]:
            return d["id"]
    return devices[0]["id"]


def with_device_fallback(fn, device_id=""):
    """Run a player action; on NO_ACTIVE_DEVICE, retry against the first
    device Spotify Connect knows about (typically the local desktop app)."""
    try:
        return fn(device_id)
    except ApiError as err:
        if err.code != "no_device" or device_id:
            raise
        fallback = first_device_id()
        if not fallback:
            raise
        return fn(fallback)


def cmd_play(args):
    body = {}
    if args.context:
        body["context_uri"] = safe_uris([args.context])[0]
    if args.uris:
        body["uris"] = safe_uris(args.uris)
    if args.offset_uri:
        body["offset"] = {"uri": safe_uris([args.offset_uri])[0]}
    elif args.offset_position is not None:
        body["offset"] = {"position": int(args.offset_position)}
    if args.position_ms is not None:
        body["position_ms"] = int(args.position_ms)

    def go(device_id):
        params = {"device_id": device_id} if device_id else None
        try:
            api("PUT", "/me/player/play", params, body if body else None)
        except ApiError as err:
            # Some contexts (audiobooks, occasionally shows) refuse a context
            # play; fall back to playing the chosen item directly.
            if body.get("context_uri") and args.offset_uri and err.code.startswith("http_4"):
                api("PUT", "/me/player/play", params, {"uris": [args.offset_uri]})
            else:
                raise
        return {"played": True}

    out(with_device_fallback(go, args.device or ""))


def cmd_pause(args):
    api("PUT", "/me/player/pause")
    out({"paused": True})


def cmd_next(args):
    api("POST", "/me/player/next")
    out({"skipped": True})


def cmd_previous(args):
    api("POST", "/me/player/previous")
    out({"skipped": True})


def cmd_seek(args):
    api("PUT", "/me/player/seek", {"position_ms": max(0, int(args.position_ms))})
    out({"positionMs": int(args.position_ms)})


def cmd_volume(args):
    pct = max(0, min(100, int(args.percent)))
    api("PUT", "/me/player/volume", {"volume_percent": pct})
    out({"volume": pct})


def cmd_shuffle(args):
    state = args.state.lower() in ("on", "true", "1")
    api("PUT", "/me/player/shuffle", {"state": "true" if state else "false"})
    out({"shuffle": state})


def cmd_repeat(args):
    mode = args.mode.lower()
    if mode not in ("off", "context", "track"):
        return fail("bad_args", "repeat mode must be off, context, or track")
    api("PUT", "/me/player/repeat", {"state": mode})
    out({"repeat": mode})


def cmd_transfer(args):
    api("PUT", "/me/player", None, {"device_ids": [args.device_id], "play": bool(args.play)})
    out({"device": args.device_id})


def cmd_queue_add(args):
    uri = safe_uris([args.uri])[0]

    def go(device_id):
        params = {"uri": uri}
        if device_id:
            params["device_id"] = device_id
        api("POST", "/me/player/queue", params)
        return {"queued": args.uri}
    out(with_device_fallback(go))


def cmd_queue(args):
    payload = api("GET", "/me/player/queue") or {}
    items = [n for n in (norm_any(x) for x in payload.get("queue") or []) if n]
    out(cache_art(items[:20]))


def cmd_recent(args):
    payload = api("GET", "/me/player/recently-played", {"limit": 50}) or {}
    seen = set()
    items = []
    for entry in payload.get("items") or []:
        track = norm_track(entry.get("track")) if isinstance(entry, dict) else None
        if not track or not track["uri"] or track["uri"] in seen:
            continue
        seen.add(track["uri"])
        ctx = entry.get("context") if isinstance(entry.get("context"), dict) else {}
        track["contextUri"] = ctx.get("uri", "")
        track["contextType"] = ctx.get("type", "")
        items.append(track)
        if len(items) >= int(args.limit):
            break
    out(cache_art(items))


def cmd_playlists(args):
    raw, _ = paged("/me/playlists", {"limit": 50}, int(args.limit))
    items = [n for n in (norm_playlist(p) for p in raw) if n]
    liked_total = 0
    try:
        liked = api("GET", "/me/tracks", {"limit": 1}) or {}
        liked_total = int(liked.get("total") or 0)
    except ApiError:
        liked_total = 0
    out({"items": cache_art(items), "likedCount": liked_total})


def cmd_playlist_items(args):
    raw, total = paged("/playlists/%s/items" % safe_id(args.id), {"limit": 100, "additional_types": "track,episode"}, int(args.limit))
    items = []
    for entry in raw:
        if not isinstance(entry, dict):
            continue
        payload = entry.get("item") or entry.get("track")
        norm = norm_any(payload or {})
        if norm and norm.get("uri"):
            items.append(norm)
    out({"items": cache_art(items), "total": int(total or len(items))})


def cmd_liked(args):
    raw, total = paged("/me/tracks", {"limit": 50}, int(args.limit))
    items = [n for n in (norm_track(e.get("track") if isinstance(e, dict) else None) for e in raw) if n and n.get("uri")]
    out({"items": cache_art(items), "total": int(total or len(items))})


def cmd_audiobooks(args):
    raw, _ = paged("/me/audiobooks", {"limit": 50}, int(args.limit))
    items = []
    for entry in raw:
        payload = entry.get("audiobook") if isinstance(entry, dict) and isinstance(entry.get("audiobook"), dict) else entry
        norm = norm_audiobook(payload)
        if norm and norm.get("uri"):
            items.append(norm)
    out(cache_art(items))


def cmd_audiobook_chapters(args):
    book_id = safe_id(args.id)
    book = api("GET", "/audiobooks/%s" % book_id) or {}
    raw, total = paged("/audiobooks/%s/chapters" % book_id, {"limit": 50}, int(args.limit))
    parent = {"name": book.get("name", ""), "uri": book.get("uri", ""), "images": book.get("images")}
    items = [n for n in (norm_chapter(c, 64, parent) for c in raw) if n and n.get("uri")]
    out({"items": items, "total": int(total or len(items)), "book": cache_art([norm_audiobook(book, 300) or {}])[0]})


def cmd_shows(args):
    raw, _ = paged("/me/shows", {"limit": 50}, int(args.limit))
    items = []
    for entry in raw:
        payload = entry.get("show") if isinstance(entry, dict) and isinstance(entry.get("show"), dict) else entry
        norm = norm_show(payload)
        if norm and norm.get("uri"):
            items.append(norm)
    out(cache_art(items))


def cmd_show_episodes(args):
    show_id = safe_id(args.id)
    show = api("GET", "/shows/%s" % show_id) or {}
    raw, total = paged("/shows/%s/episodes" % show_id, {"limit": 50}, int(args.limit))
    parent = {"name": show.get("name", ""), "uri": show.get("uri", ""), "images": show.get("images")}
    items = [n for n in (norm_episode(e, 64, parent) for e in raw) if n and n.get("uri")]
    out({"items": cache_art(items), "total": int(total or len(items)), "show": cache_art([norm_show(show, 300) or {}])[0]})


def cmd_album_tracks(args):
    album_id = safe_id(args.id)
    album = api("GET", "/albums/%s" % album_id) or {}
    raw, total = paged("/albums/%s/tracks" % album_id, {"limit": 50}, int(args.limit))
    art = art_url(album.get("images"), 64)
    items = []
    for t in raw:
        norm = norm_track(t)
        if norm and norm.get("uri"):
            norm["album"] = album.get("name", "")
            norm["art"] = art
            items.append(norm)
    out({"items": cache_art(items), "total": int(total or len(items)), "album": cache_art([norm_album(album, 300) or {}])[0]})


SEARCH_TYPES = ["track", "artist", "album", "playlist", "show", "episode", "audiobook"]


def cmd_search(args):
    query = (args.query or "").strip()
    if not query:
        out({"query": "", "groups": []})
        return
    types = [t for t in (args.types or "").split(",") if t in SEARCH_TYPES] or SEARCH_TYPES
    limit = max(1, min(10, int(args.limit)))
    payload = api("GET", "/search", {"q": query, "type": ",".join(types), "limit": limit}) or {}
    plural = {"track": "tracks", "artist": "artists", "album": "albums", "playlist": "playlists",
              "show": "shows", "episode": "episodes", "audiobook": "audiobooks"}
    groups = []
    for kind in types:
        bucket = payload.get(plural[kind]) or {}
        items = [n for n in (norm_any(x) for x in bucket.get("items") or []) if n and n.get("uri")]
        if items:
            groups.append({"type": kind, "items": items})
    cache_art(groups)
    out({"query": query, "groups": groups})


def cmd_library_contains(args):
    uris = safe_uris(args.uris)
    payload = api("GET", "/me/library/contains", {"uris": ",".join(uris)})
    flags = payload if isinstance(payload, list) else []
    out({uri: bool(flag) for uri, flag in zip(uris, flags)})


def cmd_library_save(args):
    # The 2026 library endpoints take the URIs as a query parameter; a JSON
    # body is answered with "Missing required field: uris".
    uris = safe_uris(args.uris)
    api("PUT", "/me/library", {"uris": ",".join(uris)})
    out({"saved": uris})


def cmd_library_remove(args):
    uris = safe_uris(args.uris)
    api("DELETE", "/me/library", {"uris": ",".join(uris)})
    out({"removed": uris})


# --------------------------------------------------------------------- main

def build_parser():
    parser = argparse.ArgumentParser(prog="spotify-bridge", description=__doc__.split("\n\n")[0])
    sub = parser.add_subparsers(dest="command", required=True)

    sub.add_parser("status").set_defaults(fn=cmd_status)
    p = sub.add_parser("auth")
    p.add_argument("--client-id", default="")
    p.add_argument("--port", type=int, default=8888)
    p.add_argument("--timeout", type=int, default=300)
    p.add_argument("--no-browser", action="store_true")
    p.add_argument("--print-url", action="store_true")
    p.set_defaults(fn=cmd_auth)
    sub.add_parser("logout").set_defaults(fn=cmd_logout)
    sub.add_parser("me").set_defaults(fn=cmd_me)
    p = sub.add_parser("daemon"); p.add_argument("action"); p.set_defaults(fn=cmd_daemon)
    p = sub.add_parser("soloist"); p.add_argument("action"); p.set_defaults(fn=cmd_soloist)

    sub.add_parser("player").set_defaults(fn=cmd_player)
    sub.add_parser("devices").set_defaults(fn=cmd_devices)
    p = sub.add_parser("play")
    p.add_argument("--context", default="")
    p.add_argument("--uris", nargs="*", default=[])
    p.add_argument("--offset-uri", default="")
    p.add_argument("--offset-position", type=int, default=None)
    p.add_argument("--position-ms", type=int, default=None)
    p.add_argument("--device", default="")
    p.set_defaults(fn=cmd_play)
    sub.add_parser("pause").set_defaults(fn=cmd_pause)
    sub.add_parser("next").set_defaults(fn=cmd_next)
    sub.add_parser("previous").set_defaults(fn=cmd_previous)
    p = sub.add_parser("seek"); p.add_argument("position_ms", type=int); p.set_defaults(fn=cmd_seek)
    p = sub.add_parser("volume"); p.add_argument("percent", type=int); p.set_defaults(fn=cmd_volume)
    p = sub.add_parser("shuffle"); p.add_argument("state"); p.set_defaults(fn=cmd_shuffle)
    p = sub.add_parser("repeat"); p.add_argument("mode"); p.set_defaults(fn=cmd_repeat)
    p = sub.add_parser("transfer"); p.add_argument("device_id"); p.add_argument("--play", action="store_true"); p.set_defaults(fn=cmd_transfer)
    p = sub.add_parser("queue-add"); p.add_argument("uri"); p.set_defaults(fn=cmd_queue_add)
    sub.add_parser("queue").set_defaults(fn=cmd_queue)
    p = sub.add_parser("recent"); p.add_argument("--limit", type=int, default=12); p.set_defaults(fn=cmd_recent)

    p = sub.add_parser("playlists"); p.add_argument("--limit", type=int, default=500); p.set_defaults(fn=cmd_playlists)
    p = sub.add_parser("playlist-items"); p.add_argument("id"); p.add_argument("--limit", type=int, default=300); p.set_defaults(fn=cmd_playlist_items)
    p = sub.add_parser("liked"); p.add_argument("--limit", type=int, default=100); p.set_defaults(fn=cmd_liked)
    p = sub.add_parser("audiobooks"); p.add_argument("--limit", type=int, default=200); p.set_defaults(fn=cmd_audiobooks)
    p = sub.add_parser("audiobook-chapters"); p.add_argument("id"); p.add_argument("--limit", type=int, default=300); p.set_defaults(fn=cmd_audiobook_chapters)
    p = sub.add_parser("shows"); p.add_argument("--limit", type=int, default=200); p.set_defaults(fn=cmd_shows)
    p = sub.add_parser("show-episodes"); p.add_argument("id"); p.add_argument("--limit", type=int, default=100); p.set_defaults(fn=cmd_show_episodes)
    p = sub.add_parser("album-tracks"); p.add_argument("id"); p.add_argument("--limit", type=int, default=100); p.set_defaults(fn=cmd_album_tracks)
    p = sub.add_parser("search"); p.add_argument("query"); p.add_argument("--types", default=""); p.add_argument("--limit", type=int, default=6); p.set_defaults(fn=cmd_search)

    p = sub.add_parser("library-contains"); p.add_argument("uris", nargs="+"); p.set_defaults(fn=cmd_library_contains)
    p = sub.add_parser("library-save"); p.add_argument("uris", nargs="+"); p.set_defaults(fn=cmd_library_save)
    p = sub.add_parser("library-remove"); p.add_argument("uris", nargs="+"); p.set_defaults(fn=cmd_library_remove)
    return parser


def main(argv):
    scrub_environment()
    args = build_parser().parse_args(argv)
    try:
        args.fn(args)
        return 0
    except ApiError as err:
        fail(err.code, err.message, {"status": err.status, "retryAfter": err.retry_after})
        return 0
    except KeyboardInterrupt:
        fail("cancelled", "Cancelled")
        return 0
    except Exception as err:  # noqa: BLE001 — surfaced to the panel as text
        fail("internal", "%s: %s" % (type(err).__name__, err))
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

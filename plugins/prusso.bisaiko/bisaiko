#!/usr/bin/env bash

set -u

app_id="org.omarchy.bisaiko"
module_name="prusso.bisaiko"

die() {
  printf 'bisaiko: %s\n' "$1" >&2
  exit 1
}

# True only when "$1" is a real directory (not a symlink) exclusively owned by
# the current user with 0700 permissions.
is_private_dir() {
  local path="$1" info
  [[ -n "$path" && -d "$path" && ! -L "$path" ]] || return 1
  info="$(stat -c '%u %a' "$path" 2>/dev/null)" || return 1
  [[ "$info" == "${UID} 700" ]]
}

# Pick a base directory for runtime state. Prefer a properly private
# XDG_RUNTIME_DIR; otherwise fall back to /tmp but never trust a pre-existing
# path there without validating ownership, permissions, and that it is not a
# symlink planted by another user.
resolve_state_dir() {
  local base dir
  if [[ -n "${XDG_RUNTIME_DIR:-}" ]] && is_private_dir "${XDG_RUNTIME_DIR}"; then
    base="${XDG_RUNTIME_DIR}"
  else
    base="/tmp"
  fi
  dir="${base}/bisaiko-${UID}"
  if [[ -L "$dir" ]]; then
    die "refusing to use ${dir}: it is a symlink"
  elif [[ -e "$dir" ]]; then
    is_private_dir "$dir" ||
      die "refusing to use ${dir}: not a private directory owned by uid ${UID} with mode 700"
  else
    (umask 077 && mkdir "$dir") || die "could not create ${dir}"
    is_private_dir "$dir" || die "created ${dir} but it is not private"
  fi
  printf '%s' "$dir"
}

state_dir="$(resolve_state_dir)" || exit 1
[[ -n "$state_dir" ]] || die "could not resolve a private runtime directory"
lock_file="${state_dir}/lock"
pid_file="${state_dir}/pid"
token_file="${state_dir}/token"
pinned_file="${state_dir}/pinned"
hover_file="${state_dir}/hover"
workspace_file="${state_dir}/workspace"

# Only trust an external foot control socket when it lives in a genuinely
# private runtime directory. In the /tmp fallback we never connect to a
# predictable socket path another user could have created.
if [[ -n "${XDG_RUNTIME_DIR:-}" ]] && is_private_dir "${XDG_RUNTIME_DIR}"; then
  runtime_root="${XDG_RUNTIME_DIR%/}"
else
  runtime_root=""
fi

self_path="$(readlink -f "$0")"
shell_config="${XDG_CONFIG_HOME:-${HOME}/.config}/omarchy/shell.json"

read_state() {
  local path="$1"
  local fallback="$2"
  if [[ -f "$path" && ! -L "$path" && -r "$path" ]]; then
    IFS= read -r state_value < "$path"
    printf '%s' "${state_value:-$fallback}"
  else
    printf '%s' "$fallback"
  fi
}

write_state() {
  printf '%s\n' "$2" > "$1"
}

client_json() {
  hyprctl clients -j 2>/dev/null |
    jq -c --arg app_id "$app_id" '[.[] | select(
      .class == $app_id or ((.class // "") | startswith($app_id + ".")) or
      .initialClass == $app_id or ((.initialClass // "") | startswith($app_id + "."))
    )] | first // empty' 2>/dev/null
}

normalize_position() {
  case "${1:-}" in
    top-left|top-center|top-right|middle-left|center|middle-right|bottom-left|bottom-center|bottom-right)
      printf '%s' "$1"
      ;;
    *)
      printf 'top-center'
      ;;
  esac
}

normalize_poll_ms() {
  local value="${1:-80}"
  [[ "$value" =~ ^[0-9]+$ ]] || value=80
  (( value < 10 )) && value=10
  (( value > 500 )) && value=500
  printf '%d' "$value"
}

workspace_context() {
  hyprctl monitors -j 2>/dev/null |
    jq -r '[.[] | select(.focused == true)][0] |
      (.specialWorkspace.name // ""), (.activeWorkspace.id // empty)' 2>/dev/null
}

special_workspace() {
  hyprctl monitors -j 2>/dev/null |
    jq -r '[.[] | select(.focused == true)][0].specialWorkspace.name // ""' 2>/dev/null
}

active_workspace() {
  hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty' 2>/dev/null
}

bar_section() {
  local id="${1:-$module_name}"
  [[ -r "$shell_config" ]] || return 0
  jq -r --arg id "$id" '
    ["left", "center", "right"][] as $section |
    select(any(.bar.layout[$section][]?;
      (if type == "string" then . else .id // "" end) == $id)) |
    $section
  ' "$shell_config" 2>/dev/null | head -n 1
}

close_popup() {
  local client address popup_pid
  client="$(client_json)"
  address="$(jq -r '.address // empty' <<< "$client" 2>/dev/null)"

  popup_pid=""
  if [[ -f "$pid_file" && ! -L "$pid_file" ]]; then
    popup_pid="$(read_state "$pid_file" "")"
  fi

  if [[ -n "$address" ]]; then
    hyprctl dispatch "hl.dsp.window.close({ window = \"address:${address}\" })" >/dev/null 2>&1 || true
  fi

  if [[ "$popup_pid" =~ ^[0-9]+$ ]] && kill -0 "$popup_pid" 2>/dev/null; then
    for _ in {1..3}; do
      sleep 0.1
      kill -0 "$popup_pid" 2>/dev/null || break
    done
  fi

  if [[ "$popup_pid" =~ ^[0-9]+$ ]] && kill -0 "$popup_pid" 2>/dev/null; then
    kill -TERM -- "-${popup_pid}" 2>/dev/null || kill -TERM "$popup_pid" 2>/dev/null || true
  fi

  rm -f "$pid_file" "$token_file" "$pinned_file" "$hover_file" "$workspace_file"
}

open_popup() {
  local pin_mode="$1"
  local position poll_ms popup_app_id
  position="$(normalize_position "${2:-top-center}")"
  poll_ms="$(normalize_poll_ms "${3:-80}")"
  popup_app_id="${app_id}.${position}"
  local existing token popup_pid workspace
  local -a context
  local -a terminal=(foot)

  existing="$(client_json)"
  if [[ -n "$existing" ]]; then
    return 0
  fi

  mapfile -t context < <(workspace_context)
  [[ -z "${context[0]:-}" ]] || return 0

  workspace="${context[1]:-}"
  token="${BASHPID}-${RANDOM}-${RANDOM}"
  write_state "$token_file" "$token"
  write_state "$pinned_file" "$pin_mode"
  write_state "$workspace_file" "$workspace"

  if [[ -n "$runtime_root" ]] && command -v footclient >/dev/null 2>&1 && [[ -S "${runtime_root}/foot.sock" ]]; then
    terminal=(footclient --server-socket="${runtime_root}/foot.sock")
  fi

  setsid "${terminal[@]}" --app-id="$popup_app_id" --title="Bisaikō" --window-size-chars=80x24 btop 9>&- >/dev/null 2>&1 &
  popup_pid=$!
  write_state "$pid_file" "$popup_pid"

  setsid "$self_path" watch "$token" "$poll_ms" 9>&- >/dev/null 2>&1 &
}

watch_popup() {
  local expected_token="$1"
  local poll_ms poll_interval
  poll_ms="$(normalize_poll_ms "${2:-80}")"
  printf -v poll_interval '0.%03d' "$poll_ms"
  local client="" address="" at_x=0 at_y=0 width=0 height=0
  local cursor_json cursor_x cursor_y current_workspace initial_workspace
  local outside_ticks=0 refresh_tick=0

  for _ in {1..30}; do
    [[ "$(read_state "$token_file" "")" == "$expected_token" ]] || return 0
    client="$(client_json)"
    [[ -n "$client" ]] && break
    sleep 0.1
  done

  if [[ -z "$client" ]]; then
    close_popup
    return 0
  fi

  initial_workspace="$(read_state "$workspace_file" "")"

  while [[ "$(read_state "$token_file" "")" == "$expected_token" ]]; do
    if (( refresh_tick == 0 )); then
      client="$(client_json)"
      [[ -n "$client" ]] || break
      address="$(jq -r '.address' <<< "$client")"
      at_x="$(jq -r '.at[0]' <<< "$client")"
      at_y="$(jq -r '.at[1]' <<< "$client")"
      width="$(jq -r '.size[0]' <<< "$client")"
      height="$(jq -r '.size[1]' <<< "$client")"
      current_workspace="$(active_workspace)"

      if [[ "$current_workspace" != "$initial_workspace" || -n "$(special_workspace)" ]]; then
        close_popup
        return 0
      fi
    fi
    refresh_tick=$(((refresh_tick + 1) % 5))

    if [[ "$(read_state "$pinned_file" "0")" == "1" || "$(read_state "$hover_file" "0")" == "1" ]]; then
      outside_ticks=0
      sleep "$poll_interval"
      continue
    fi

    cursor_json="$(hyprctl cursorpos -j 2>/dev/null)"
    cursor_x="$(jq -r '.x // -1' <<< "$cursor_json")"
    cursor_y="$(jq -r '.y // -1' <<< "$cursor_json")"

    if (( cursor_x >= at_x && cursor_x < at_x + width && cursor_y >= at_y && cursor_y < at_y + height )); then
      outside_ticks=0
    else
      outside_ticks=$((outside_ticks + 1))
      if (( outside_ticks >= 3 )); then
        close_popup
        return 0
      fi
    fi

    sleep "$poll_interval"
  done

  rm -f "$pid_file" "$token_file" "$pinned_file" "$hover_file" "$workspace_file"
}

action="${1:-status}"

case "$action" in
  enter)
    (
      flock -x 9
      write_state "$hover_file" "1"
      open_popup "0" "${2:-top-center}" "${3:-80}"
    ) 9>"$lock_file"
    ;;
  leave)
    (
      flock -x 9
      write_state "$hover_file" "0"
    ) 9>"$lock_file"
    ;;
  toggle)
    (
      flock -x 9
      if [[ -n "$(client_json)" ]]; then
        if [[ "$(read_state "$pinned_file" "0")" == "1" ]]; then
          close_popup
        else
          write_state "$pinned_file" "1"
        fi
      else
        open_popup "1" "${2:-top-center}" "${3:-80}"
      fi
    ) 9>"$lock_file"
    ;;
  open)
    (
      flock -x 9
      write_state "$hover_file" "1"
      open_popup "0" "${2:-top-center}" "${3:-80}"
    ) 9>"$lock_file"
    ;;
  pin)
    (
      flock -x 9
      if [[ -n "$(client_json)" || -n "$(read_state "$token_file" "")" ]]; then
        write_state "$pinned_file" "1"
      else
        open_popup "1" "${2:-top-center}" "${3:-80}"
      fi
    ) 9>"$lock_file"
    ;;
  unpin)
    (
      flock -x 9
      write_state "$pinned_file" "0"
    ) 9>"$lock_file"
    ;;
  close)
    (
      flock -x 9
      close_popup
    ) 9>"$lock_file"
    ;;
  watch)
    watch_popup "${2:-}" "${3:-80}"
    ;;
  status)
    if [[ -n "$(client_json)" ]]; then
      printf '%s\n' "$(read_state "$pinned_file" "0")"
    else
      printf 'closed\n'
    fi
    ;;
  bar-section)
    bar_section "${2:-}"
    ;;
  *)
    printf 'Usage: %s {enter|leave|toggle|open|pin|unpin|close|status|bar-section}\n' "${0##*/}" >&2
    exit 2
    ;;
esac

#!/usr/bin/env python3
"""Work out where the sky is in a wallpaper, so the weather can be composed on it.

Prints the sky block of the state file as JSON:

    {"horizon": 0.34, "skyLeft": 0.16, "sunX": 0.60, "sunY": 0.14, ...}

The numbers are fractions of the image. What each one means is documented in
WeatherState.qml; in short: `horizon` is where sky stops and land starts,
`skyLeft` is how far in from the left edge the sky is actually visible past any
foreground, and sun/moon go in the most open, brightest patch of sky.

Usage:  detect-sky <image>  [--debug]

Only needs ImageMagick and the standard library. Deliberately conservative: a
wallpaper with no sky at all (a close-up, a texture) yields a low horizon and a
centred disc rather than a confident wrong answer.
"""

import json
import math
import subprocess
import sys

# Coarse enough that one bright window or a bird cannot move the horizon, fine
# enough to find a gap between two buildings.
COLS, ROWS = 96, 54


def sample(path):
    """Return a ROWS x COLS grid of perceived luminance in 0..1."""
    out = subprocess.run(
        ["magick", path, "-resize", f"{COLS}x{ROWS}!", "-colorspace", "sRGB", "txt:-"],
        capture_output=True, text=True, check=True).stdout

    grid = [[0.0] * COLS for _ in range(ROWS)]
    rgb = [[(0.0, 0.0, 0.0)] * COLS for _ in range(ROWS)]
    for line in out.splitlines():
        if not line or line.startswith("#"):
            continue
        # "x,y: (r,g,b) #RRGGBB srgb(...)"
        head, _, rest = line.partition(":")
        try:
            x, y = (int(v) for v in head.split(","))
        except ValueError:
            continue
        hexpart = rest.split("#", 1)
        if len(hexpart) < 2:
            continue
        h = hexpart[1][:6]
        try:
            r, g, b = (int(h[i:i + 2], 16) / 255 for i in (0, 2, 4))
        except ValueError:
            continue
        if 0 <= x < COLS and 0 <= y < ROWS:
            # Rec.709 luma: green dominates perceived brightness.
            grid[y][x] = 0.2126 * r + 0.7152 * g + 0.0722 * b
            rgb[y][x] = (r, g, b)
    return grid, rgb


def band_colour(rgb, top_row, bottom_row):
    """Average colour of a horizontal band, as #rrggbb.

    Fog tinted with the picture's own haze sits in the image instead of on top
    of it; white mist over a green city reads as a grey smear.
    """
    rows = [y for y in range(max(0, int(top_row)), min(ROWS, int(bottom_row) + 1))]
    if not rows:
        rows = [ROWS // 2]
    n = len(rows) * COLS
    r = sum(rgb[y][x][0] for y in rows for x in range(COLS)) / n
    g = sum(rgb[y][x][1] for y in rows for x in range(COLS)) / n
    b = sum(rgb[y][x][2] for y in rows for x in range(COLS)) / n
    # Lift it toward white: haze is the scene seen through lit air, always
    # paler than the scene itself.
    r, g, b = (min(1.0, c * 0.45 + 0.55) for c in (r, g, b))
    return "#%02x%02x%02x" % tuple(int(round(c * 255)) for c in (r, g, b))


def row_means(grid):
    return [sum(row) / len(row) for row in grid]


def find_horizon(means):
    """The row where brightness falls away fastest, top-down.

    Sky is nearly always brighter than what is under it, and the transition is
    the sharpest sustained drop in the image. Compare a window above each row
    with the window below it rather than adjacent rows, so a single dark cloud
    band does not read as ground.
    """
    win = max(2, ROWS // 12)
    best, best_drop = None, 0.0
    # Only look in the top two-thirds: a horizon below that is a close-up, not a
    # landscape, and guessing there does more harm than leaving it low.
    for y in range(win, int(ROWS * 0.66)):
        above = sum(means[y - win:y]) / win
        below = sum(means[y:y + win]) / win
        drop = above - below
        if drop > best_drop:
            best_drop, best = drop, y
    if best is None or best_drop < 0.02:
        # No clear horizon: treat the top third as sky and stay out of the way.
        return ROWS / 3.0 / ROWS, False
    return best / ROWS, True


def find_sky_left(grid, horizon_row):
    """First column from the left where the sky band is actually sky.

    Foreground objects -- a building, a tree -- eat the sky from one edge. Stars
    drawn over them look like stars inside a wall, so find where the sky band
    stops being dark and start there.
    """
    band = max(1, int(horizon_row * 0.7))
    col_means = []
    for x in range(COLS):
        col_means.append(sum(grid[y][x] for y in range(band)) / band)
    if not col_means:
        return 0.0
    bright = sorted(col_means)[int(len(col_means) * 0.75)]
    if bright <= 0.01:
        return 0.0
    for x, v in enumerate(col_means):
        if v >= bright * 0.6:
            return x / COLS
    return 0.0


def row_contrast(grid):
    """Spread of luminance across each row.

    Haze is exactly the loss of this: distance washes detail out and pulls
    everything toward the sky's brightness, so a hazy band reads as a run of
    rows with unusually little variation across them.
    """
    out = []
    for row in grid:
        mean = sum(row) / len(row)
        var = sum((v - mean) ** 2 for v in row) / len(row)
        out.append(var ** 0.5)
    return out


def find_mist_band(grid, horizon_row):
    """The hazy band under the horizon: where the far mist layer belongs.

    Low contrast alone is not haze -- a black rooftop silhouette is flat too,
    and picking it puts the fog in the foreground where it reads as smeared
    dirt. What separates them is brightness: haze washes detail out *and* pulls
    what is left toward the sky's own brightness, while a silhouette loses
    detail by going dark.

    So score each row on both, and take the longest run that scores well.
    Returns (top, height) as fractions.
    """
    contrast = row_contrast(grid)
    means = row_means(grid)
    lo = max(1, int(horizon_row))
    hi = min(ROWS - 1, int(ROWS * 0.88))
    fallback = (horizon_row / ROWS * 0.95, max(0.10, horizon_row / ROWS))
    if hi - lo < 3:
        return fallback

    sky = sum(means[:max(1, lo)]) / max(1, lo)
    if sky <= 0.01:
        return fallback

    span = max(contrast[lo:hi]) - min(contrast[lo:hi])
    if span < 0.01:
        return fallback
    cmin = min(contrast[lo:hi])

    scores = []
    for y in range(lo, hi):
        flat = 1.0 - (contrast[y] - cmin) / span          # 1 = featureless
        lit = min(1.0, means[y] / sky)                    # 1 = as bright as sky
        scores.append(flat * lit)

    best_score = max(scores)
    if best_score < 0.12:
        return fallback

    # Rows within 70% of the best count as part of the same band.
    threshold = best_score * 0.7
    runs, start_y = [], None
    for i, sc in enumerate(scores):
        if sc >= threshold:
            if start_y is None:
                start_y = i
        elif start_y is not None:
            runs.append((start_y, i - 1))
            start_y = None
    if start_y is not None:
        runs.append((start_y, len(scores) - 1))
    if not runs:
        return fallback

    top, bottom = max(runs, key=lambda r: r[1] - r[0])
    return (top + lo) / ROWS, max(2, bottom - top + 1) / ROWS


def find_disc(grid, horizon_row):
    """Brightest open patch of sky: where a sun or moon belongs.

    Weighted toward the middle of the sky band vertically, and away from the
    edges horizontally, so the disc lands somewhere it can actually be seen
    rather than half off-screen.
    """
    band = max(2, int(horizon_row))
    best, best_score = (0.5, 0.35), -1.0
    r = max(1, COLS // 24)
    for y in range(0, band):
        for x in range(r, COLS - r):
            patch = [grid[yy][xx]
                     for yy in range(max(0, y - r), min(band, y + r + 1))
                     for xx in range(x - r, x + r + 1)]
            score = sum(patch) / len(patch)
            # Keep it away from the very edges, but let a genuinely brighter
            # patch win; and push it up, because the brightest sky is usually
            # the glow just above the skyline, where a disc would sit on the
            # horizon rather than in open sky.
            score *= 1.0 - 0.22 * abs((x / COLS) - 0.5) * 2.0
            score *= 1.0 - 0.80 * (y / max(1, band))
            if score > best_score:
                best_score, best = score, (x / COLS, y / ROWS)
    return best


def main():
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    debug = "--debug" in sys.argv
    if not args:
        print("usage: detect-sky <image> [--debug]", file=sys.stderr)
        return 2

    try:
        grid, rgb = sample(args[0])
    except (subprocess.CalledProcessError, FileNotFoundError) as error:
        print(f"detect-sky: could not read {args[0]}: {error}", file=sys.stderr)
        return 1

    means = row_means(grid)
    horizon, confident = find_horizon(means)
    horizon_row = horizon * ROWS
    sky_left = find_sky_left(grid, horizon_row)
    disc_x, disc_y = find_disc(grid, horizon_row)
    mist_y, mist_h = find_mist_band(grid, horizon_row)

    # Keep the disc clear of the horizon it was found near, and the ground well
    # below it, so mist and fireflies do not sit in the sky.
    sky = {
        "horizon": round(max(0.10, min(0.60, horizon)), 3),
        "skyLeft": round(max(0.0, min(0.45, sky_left)), 3),
        "sunX": round(disc_x, 3),
        "sunY": round(max(0.06, min(horizon * 0.75, disc_y)), 3),
        "moonX": round(disc_x, 3),
        "moonY": round(max(0.05, min(horizon * 0.6, disc_y * 0.85)), 3),
        "sunSize": 0.95,
        "moonSize": 0.52,
        "groundLevel": round(max(0.30, min(0.75, horizon + 0.08)), 3),
        "mistY": round(max(0.0, min(0.85, mist_y)), 3),
        "mistHeight": round(max(0.16, min(0.60, mist_h)), 3),
        "hazeColor": band_colour(rgb, mist_y * ROWS, (mist_y + mist_h) * ROWS),
    }

    if debug:
        print("# row brightness (top to bottom)", file=sys.stderr)
        for y in range(0, ROWS, 3):
            bar = "#" * int(means[y] * 60)
            mark = "  <- horizon" if abs(y - horizon_row) < 1.5 else ""
            print(f"#  {y:3d} {means[y]:.3f} {bar}{mark}", file=sys.stderr)
        print(f"# confident horizon: {confident}", file=sys.stderr)
        c = row_contrast(grid)
        print("# row contrast (haze = low)", file=sys.stderr)
        for y in range(0, ROWS, 3):
            inband = mist_y * ROWS <= y < (mist_y + mist_h) * ROWS
            print(f"#  {y:3d} {c[y]:.3f} {'#' * int(c[y] * 200)}"
                  f"{'  <- fog' if inband else ''}", file=sys.stderr)

    print(json.dumps(sky))
    return 0


if __name__ == "__main__":
    sys.exit(main())
